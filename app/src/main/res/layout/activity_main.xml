<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBgMain"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/dbm_value_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/waiting_for_reading"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/asu_level_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/network_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorSurface" />

    <TextView
        android:id="@+id/stats_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="15sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/samples_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/permission_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/permission_needed"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/grant_permission_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/grant_permission_button"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:visibility="gone"
        android:nextFocusUp="@id/reset_button"
        android:nextFocusDown="@id/reset_button" />

    <Button
        android:id="@+id/reset_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/reset_button"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:focusable="true"
        android:nextFocusUp="@id/grant_permission_button"
        android:nextFocusDown="@id/grant_permission_button" />

</LinearLayout>
